# Build output
bin/
obj/

# Packaged mod artifacts
*.zip

# Local version backups kept on disk (not tracked)
1.5.0/
*.old

# pCloud sync conflict artifacts (literal "[conflicted]" in the name)
*\[conflicted\]*

# Claude local settings
.claude/settings.local.json

# Editor / OS cruft
*.user
*.suo
.vs/
.DS_Store

# Screenshots, stock photos and store art kept locally (root level only,
# so asset textures under assets/ are unaffected)
/*.png
/*.jpg

# Player reply drafts are never committed. They are written for pasting onto
# the ModDB, not for people reading the source.
docs/replies/
replies/
*-reply-*.md
*-replies-*.md
