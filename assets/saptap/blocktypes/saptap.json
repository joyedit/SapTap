{
  "code": "saptap",
  "class": "BlockSapTap",
  "entityClass": "BlockEntitySapTap",

  "//": "The shape is authored for the 'north' variant: 'side' names the direction the tap faces INTO the tree, so for -north the bark plane is z=0 and the tube points south. rotateY +90 maps south->east->north->west, same convention vanilla uses for the toolrack.",

  "variantgroups": [
    {
      "code": "metal",
      "states": ["copper", "tinbronze", "bismuthbronze", "blackbronze", "brass", "gold", "silver", "lead", "bismuth", "molybdochalkos", "iron", "meteoriciron", "steel"]
    },
    {
      "code": "side",
      "states": ["north", "east", "south", "west"]
    }
  ],

  "drawtype": "json",
  "shapeByType": {
    "*-north": { "base": "saptap:block/saptap", "rotateY": 0 },
    "*-west":  { "base": "saptap:block/saptap", "rotateY": 90 },
    "*-south": { "base": "saptap:block/saptap", "rotateY": 180 },
    "*-east":  { "base": "saptap:block/saptap", "rotateY": 270 }
  },
  "textures": {
