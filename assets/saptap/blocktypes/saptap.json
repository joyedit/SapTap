    "x1": 0.34, "y1": 0.55, "z1": 0.0, "x2": 0.66, "y2": 0.96, "z2": 0.63,
    "rotateYByType": {
      "*-north": 0,
      "*-west": 90,
      "*-south": 180,
      "*-east": 270
