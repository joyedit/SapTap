// Two recipes per output metal: one taking the smithed metal plate ITEM
// (game:metalplate-<metal>), one taking the metal sheet BLOCK
// (game:metalsheet-<metal>-<side>). They look nearly identical in the inventory,
// so accept either.
//
// Do NOT collapse these with a `name:` wildcard binding on the stock ingredient:
// when the game expands such a recipe per variant it clears allowedVariants on
// EVERY ingredient, silently disabling the hammer/chisel hardness gate.
[
  {
    "ingredientPattern": "HPC",
    "ingredients": {
      "H": {
        "type": "item",
        "code": "game:hammer-*",
        "isTool": true,
        "toolDurabilityCost": 8,
        "allowedVariants": [
          "tinbronze",
          "bismuthbronze",
          "blackbronze",
          "iron",
          "meteoriciron",
          "steel"
        ]
      },
      "P": {
        "type": "item",
        "code": "game:metalplate-copper"
      },
      "C": {
        "type": "item",
        "code": "game:chisel-*",
        "isTool": true,
        "toolDurabilityCost": 8,
        "allowedVariants": [
          "tinbronze",
          "bismuthbronze",
          "blackbronze",
          "iron",
          "meteoriciron",
          "steel"
        ]
      }
    },
    "width": 3,
    "height": 1,
    "shapeless": true,
    "output": {
